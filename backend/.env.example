APP_NAME=GolsFintech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:6060

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=golsfintech
DB_USERNAME=golsfintech
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Adaptadores de los puertos (config/adapters.php) --------------------------
# Que adaptador queda activo se decide aqui y en ningun otro lugar. En T4 los
# cuatro servicios externos van SIMULADOS: no hay convenio con INE ni con RENAPO,
# el entorno es de desarrollo y ningun adaptador abre conexiones ni usa
# credenciales. Los adaptadores reales se registran en AdapterServiceProvider.
PERSISTENCE_DRIVER=eloquent
OCR_DRIVER=simulated
IDENTITY_DRIVER=simulated
CARD_DRIVER=simulated
NOTIFICATION_DRIVER=simulated

# Escenarios de simulacion. Vacio = cada entrada decide su desenlace: un documento
# cuyo nombre contenga "sandbox-timeout" agota el tiempo, y las CURP de laboratorio
# de config/adapters.php (empiezan por XEXX) reproducen rechazo, indisponibilidad y
# marca antifraude. Con estas variables se fuerza el desenlace para todo el entorno.
# OCR_SIMULATED_SCENARIO=timeout          # extracted | timeout | unreadable
# IDENTITY_SIMULATED_SCENARIO=rejected    # verified | rejected | unavailable | fraud
# OCR_SIMULATED_FAIL_ENQUEUE=true         # la cola de OCR no acepta trabajos
# CARD_SIMULATED_FAIL=true                # el procesador rechaza la emision
# NOTIFICATION_SIMULATED_FAIL=true        # la pasarela no acepta el envio

# --- Autenticacion y control de acceso (T5) ------------------------------------
# Origen de la SPA de Vue. Es la base del redirect_uri registrado para el cliente
# publico de OAuth2: el servidor solo redirige a URIs registradas, de modo que un
# redirect_uri manipulado en la peticion no desvia el codigo de autorizacion.
FRONTEND_URL=http://127.0.0.1:6060

# Argon2id para las contrasenas (regla de seguridad no negociable 6). 64 MiB y 4
# pasadas es el punto de partida que recomienda OWASP. Los parametros viajan
# dentro del propio hash: subirlos no invalida las credenciales ya almacenadas.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

# Segundo factor (TOTP, RFC 6238). El algoritmo por defecto es SHA-256 y no el
# SHA-1 habitual porque la regla 6 prohibe SHA-1. Use un autenticador que respete
# el parametro algorithm del URI otpauth (Aegis, FreeOTP, 1Password); Google
# Authenticator calcula siempre con SHA-1 y no servira.
TOTP_ALGORITHM=sha256
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_WINDOW=1
TOTP_ISSUER=GolsFintech
TOTP_REAUTH_SECONDS=300

# Vida de los tokens del servidor OAuth2. El access_token dura poco a proposito:
# si se filtra, la ventana de uso es de minutos. La renovacion la resuelve el
# refresh_token, que si esta sujeto a revocacion en el servidor.
OAUTH_ACCESS_TOKEN_TTL=15
OAUTH_REFRESH_TOKEN_TTL=14

# Llaves de firma de Passport. NO se ponen aqui: `php artisan passport:keys` las
# escribe en storage/oauth-*.key, que .gitignore excluye. En produccion van en el
# vault, igual que PII_HASH_KEY.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
