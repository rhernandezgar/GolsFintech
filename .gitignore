# ---- Documentos de diseño (Fases 1-3): fuera del control de versiones ----
docs/

# ---- Secretos: nunca en el repositorio ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
secrets/

# ---- Dependencias ----
/backend/vendor/
# Dependencias del composer.json de la raiz, que solo existe para las
# herramientas de analisis (Psalm). Se versionan composer.json y composer.lock;
# el arbol instalado no.
/vendor/
node_modules/

# ---- Backend (Laravel) ----
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/backend/database/*.sqlite
/backend/database/*.sqlite-journal
/backend/Homestead.json
/backend/Homestead.yaml

# ---- Frontend / worker (Node) ----
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
coverage/

# ---- Editor / sistema operativo ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---- Artefactos temporales del proyecto ----
/tmp/
*.log
verificar.txt

# ---- Salidas de los analizadores (T12) ----
# Se versiona la CONFIGURACION del analisis -psalm.xml, codeql-config.yml- y el
# registro de lo que encontro -BUGS.md-, no sus salidas: son regenerables con el
# comando que cada entrada de BUGS.md cita, y la base de CodeQL lleva dentro una
# copia comprimida del arbol.
/psalm.txt
/resultados-vue.cs
/golfintech-vue-db/
