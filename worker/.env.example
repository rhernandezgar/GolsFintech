# Worker asincrono de GolsFintech. Copiar a .env y ajustar. Nunca commitear .env.

REDIS_URL=redis://127.0.0.1:6379

# TIENE que coincidir con BULLMQ_PREFIX del backend (config/adapters.php). Si no
# coinciden, el backend encola en un juego de claves que este worker no mira
# nunca y los trabajos se pierden sin que nadie vea un error.
BULLMQ_PREFIX=bull

OCR_QUEUE_NAME=ocr
NOTIFICATION_QUEUE_NAME=notifications
OCR_CONCURRENCY=2
NOTIFICATION_CONCURRENCY=4

# Proveedores externos (fake | http). 'fake' es determinista y sabe fallar: es
# lo que permite probar los reintentos sin proveedor real.
OCR_ADAPTER=fake
NOTIFICATION_ADAPTER=fake
#OCR_PROVIDER_URL=
#NOTIFICATION_GATEWAY_URL=

# Como devuelve el worker el resultado al backend (log | http).
# 'log' no llama a nadie: modo de desarrollo.
BACKEND_ADAPTER=log
BACKEND_BASE_URL=http://127.0.0.1:6060
BACKEND_TIMEOUT_MS=5000

# Solo con BACKEND_ADAPTER=http. El secreto va en el .env local o en el vault,
# nunca en un commit.
#BACKEND_TOKEN_URL=http://127.0.0.1:6060/api/v1/auth/token
#BACKEND_CLIENT_ID=
#BACKEND_CLIENT_SECRET=
